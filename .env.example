# ==============================================================================
# DOPAMINE AI - Environment Variables Configuration
# NOTE: Secrets must NEVER be committed to Git or exposed in frontend code!
# ==============================================================================

# Server-Side Configuration (Keep in .env on the server)
# ------------------------------------------------------------------------------
# Google AI Studio API Key (Leave blank to use the built-in Scripted Demo Mode)
GEMINI_API_KEY=

# Gemini Model Identifier (Configurable, defaults to gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-2.0-flash, models/gemini-4-hydrogen, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Server Port
PORT=3001

# Node Environment
NODE_ENV=development

# Frontend Configuration (Optional Vite overrides)
# ------------------------------------------------------------------------------
# VITE_API_URL=http://localhost:3001/api/chat
# VITE_FORCE_DEMO_MODE=false
